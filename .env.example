# Copy to .env and adjust. Real environment variables override values here.

# --- Server -----------------------------------------------------------------
APP_ADDR=:8080
# Public base URL, used to build password-reset links.
APP_BASE_URL=http://localhost:8080
# Required: at least 32 random characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
SESSION_TTL=168h
# Defaults to true when APP_BASE_URL starts with https://
SECURE_COOKIES=false
LOG_LEVEL=info
# text or json
LOG_FORMAT=text

# --- Storage ----------------------------------------------------------------
DATABASE_PATH=data/app.db
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=500

# --- AI provider (summaries, concepts, quizzes, answer evaluation) ----------
# anthropic or openai
AI_PROVIDER=anthropic
AI_API_KEY=
# Defaults: claude-opus-5-5 (anthropic), gpt-4o (openai)
AI_MODEL=
# Optional: OpenAI-compatible base URL (only used when AI_PROVIDER=openai)
AI_BASE_URL=

# --- Speech-to-text (used when a video has no captions) ---------------------
# openai (Whisper-compatible /audio/transcriptions API) or none
STT_PROVIDER=openai
STT_API_KEY=
STT_MODEL=whisper-1
STT_BASE_URL=https://api.openai.com/v1

# --- Media tools ------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Background processing --------------------------------------------------
PROCESSING_CONCURRENCY=2
PROCESSING_TIMEOUT=60m
JOB_MAX_ATTEMPTS=3

# --- Email (optional, for password reset emails) ----------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
